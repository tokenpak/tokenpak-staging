{
  "path": "/v1/messages?beta=true",
  "method": "POST",
  "headers": {
    "Content-Type": "application/json",
    "anthropic-version": "2023-06-01",
    "Accept": "text/event-stream"
  },
  "body": {
    "model": "claude-sonnet-4-6",
    "max_tokens": 256,
    "stream": true,
    "messages": [
      {"role": "user", "content": "Count from 1 to 5, one number per line, nothing else."}
    ]
  }
}
